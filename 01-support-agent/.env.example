# Model as "provider:model". Examples:
#   MODEL=ollama:qwen3:8b                 (free, local; needs Ollama running)
#   MODEL=anthropic:claude-haiku-5-5      (needs ANTHROPIC_API_KEY)
#   MODEL=openai:gpt-5.4-mini             (needs OPENAI_API_KEY)
MODEL=ollama:qwen3:8b

# Provider key, only for hosted models
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: LangSmith tracing and evals
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=pixel-and-plug-support-agent
